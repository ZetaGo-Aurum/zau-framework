{
  "name": "vscode-zau",
  "displayName": "ZAU Framework Language Support",
  "description": "Rich syntax highlighting, spatial tags autocomplete, and tooling for .zau Single File Components",
  "version": "1.0.0",
  "publisher": "zetago-aurum",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "zau",
    "spatial",
    "threejs",
    "webgl",
    "python",
    "fullstack"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zau",
        "aliases": ["ZAU", "zau"],
        "extensions": [".zau"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zau",
        "scopeName": "source.zau",
        "path": "./syntaxes/zau.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zau",
        "path": "./snippets/zau.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZetaGo-Aurum/zau-framework.git"
  },
  "author": "ZetaGo-Aurum <admin@zetagoaurum.com>",
  "license": "MIT"
}
