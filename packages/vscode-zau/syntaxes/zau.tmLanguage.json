{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zau Language",
  "scopeName": "source.zau",
  "fileTypes": [
    "zau"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#template-block"
    },
    {
      "include": "#script-block"
    },
    {
      "include": "#style-block"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#zau-spatial-tags"
    },
    {
      "include": "#zau-directives"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.html",
          "begin": "<!--",
          "end": "-->",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.html"
            }
          }
        },
        {
          "name": "comment.line.double-slash.js",
          "match": "//.*$"
        },
        {
          "name": "comment.block.js",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.number-sign.python",
          "match": "#.*$"
        }
      ]
    },
    "template-block": {
      "begin": "(<)(template)(\\s*[^>]*)?(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.template.html"
        },
        "3": {
          "name": "entity.other.attribute-name.html"
        },
        "4": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(</)(template)(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.template.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "contentName": "text.html.derivative",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#zau-spatial-tags"
        },
        {
          "include": "#zau-directives"
        },
        {
          "include": "#html-tags"
        },
        {
          "include": "text.html.basic"
        }
      ]
    },
    "script-block": {
      "begin": "(<)(script)(?:\\s+[^>]*lang=['\"](python|py)['\"][^>]*)?(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.script.html"
        },
        "3": {
          "name": "entity.other.attribute-name.html"
        },
        "4": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.script.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "contentName": "source.ts",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "source.ts"
        },
        {
          "include": "source.js"
        },
        {
          "include": "source.python"
        }
      ]
    },
    "style-block": {
      "begin": "(<)(style)(?:\\s+[^>]*lang=['\"](scss|sass|postcss)['\"][^>]*)?(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.style.html"
        },
        "3": {
          "name": "entity.other.attribute-name.html"
        },
        "4": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.style.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "contentName": "source.css",
      "patterns": [
        {
          "include": "source.css"
        },
        {
          "include": "source.css.scss"
        }
      ]
    },
    "interpolation": {
      "begin": "(\\{\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.expression.begin.zau"
        }
      },
      "end": "(\\}\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.expression.end.zau"
        }
      },
      "name": "expression.embedded.zau",
      "patterns": [
        {
          "include": "source.ts"
        },
        {
          "include": "source.js"
        }
      ]
    },
    "zau-spatial-tags": {
      "patterns": [
        {
          "match": "(</?)(zau-(?:canvas|model|camera|light|scene|spatial|mesh|orbit-controls|shadow|skybox|env|spotlight|ambient|material|geometry)|Viewer3D|SceneControls|ZAU\\.[A-Za-z0-9]+)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "entity.name.tag.zau.spatial support.class.component.zau"
            }
          }
        }
      ]
    },
    "zau-directives": {
      "patterns": [
        {
          "name": "keyword.operator.directive.event.zau",
          "match": "(@[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+)*)"
        },
        {
          "name": "keyword.operator.directive.binding.zau",
          "match": "(:[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+)*)"
        },
        {
          "name": "keyword.control.directive.zau",
          "match": "\\b(z-if|z-else-if|z-else|z-for|z-model|z-show|z-slot|z-bind|z-on)\\b"
        },
        {
          "name": "support.type.property-name.zau.spatial",
          "match": "\\b(src|progressiveLOD|tier|position|pos|rotation|rot|scale|fov|target|intensity|color|castShadow|receiveShadow|wireframe|pbr|metalness|roughness|maxTextureSize)\\b"
        }
      ]
    },
    "html-tags": {
      "patterns": [
        {
          "name": "tag.open.html",
          "match": "(<)([a-zA-Z0-9_-]+)(?=[\\s>])",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "entity.name.tag.html"
            }
          }
        },
        {
          "name": "tag.close.html",
          "match": "(</)([a-zA-Z0-9_-]+)(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "entity.name.tag.html"
            },
            "3": {
              "name": "punctuation.definition.tag.end.html"
            }
          }
        },
        {
          "name": "entity.other.attribute-name.html",
          "match": "([a-zA-Z0-9_-]+)(?==)"
        },
        {
          "name": "string.quoted.double.html",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.html",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    }
  }
}
