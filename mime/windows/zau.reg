Windows Registry Editor Version 5.00

; Register .zau extension and MIME Type on Windows
[HKEY_CLASSES_ROOT\.zau]
@="ZAU.Component"
"Content Type"="text/prs.zau"
"PerceivedType"="text"

[HKEY_CLASSES_ROOT\ZAU.Component]
@="ZAU Single File Component"

[HKEY_CLASSES_ROOT\ZAU.Component\DefaultIcon]
@="%SystemRoot%\\System32\\shell32.dll,-152"

[HKEY_CLASSES_ROOT\MIME\Database\Content Type\text/prs.zau]
"Extension"=".zau"
"CLSID"="{25336920-03F9-11cf-8FD0-00AA00686F13}"
